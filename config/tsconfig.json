{
  "compilerOptions": {
    "strict": true,
    "lib": ["ESNext"],
    "target": "esnext",
    "moduleResolution": "bundler",
    "module": "esnext",
    "outDir": "../dist",
    "rootDir": "../src",
    "strictPropertyInitialization": false,
    "types": ["node", "jest"],
    "paths": {
      "@": ["../src"],
      "@/*": ["../src/*"],
      "@types": ["../src/types"],
      "@types/*": ["../src/types/*"],
      "@const": ["../src/const"],
      "@const/*": ["../src/const/*"],
      "@utils": ["../src/utils"],
      "@utils/*": ["../src/utils/*"]
    }
  },
  "include": ["../src/**/*.ts"]
}

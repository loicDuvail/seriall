{
  "name": "seriall",
  "version": "1.2.0",
  "description": "A flexible js serializer, capable of serializing/deserializing any js data, while preserving referential integrity, non-json-primitive values, and even custom class instances",
  "author": {
    "email": "loic.duvail.pro@gmail.com",
    "name": "loicd"
  },
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf ./dist && npm run build:js && npm run build:types",
    "build:js": "node ./config/esbuild.js",
    "build:types": "rollup -c ./config/rollup.config.mjs",
    "build:test": "node ./config/esbuild.test.js",
    "build:benchmark": "node ./config/esbuild.benchmark.js",
    "test": "npm run build:test && npx jest --config=./config/jest.config.ts",
    "bench": "npm run build:benchmark && node temp/benchmark.js /",
    "typecheck": "tsc -p ./config/tsconfig.json --noEmit"
  },
  "keywords": [
    "serializer",
    "serialization",
    "circular",
    "json",
    "referential",
    "integrity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/loicDuvail/seriall.git"
  },
  "devDependencies": {
    "@esbuild-plugins/tsconfig-paths": "^0.1.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "devalue": "^6.0.2",
    "esbuild": "^0.28.2",
    "flatted": "^3.4.4",
    "jest": "^30.5.1",
    "rollup": "^4.63.6",
    "rollup-plugin-dts": "^6.5.1",
    "superjson": "^2.2.6",
    "typescript": "^6.0.3"
  }
}

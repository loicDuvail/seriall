{
  "name": "seriall",
  "version": "1.0.0",
  "description": "A flexible js serializer, capable of serializing/deserializing any js data, while preserving referential integrity, non-json-primitive values, and even custom class instances",
  "author": {
    "email": "loic.duvail.pro@gmail.com",
    "name": "loicd"
  },
  "type": "module",
  "exports": {
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf ./dist && npm run build:js && npm run build:types",
    "build:js": "node ./esbuild.js",
    "build:types": "rollup -c",
    "build:test": "node ./esbuild.test.js",
    "test": "npm run build:test && npx jest"
  },
  "keywords": [
    "serializer",
    "serialization",
    "circular",
    "json",
    "referential",
    "integrity"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/loicDuvail/seriall.git"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "rollup": "^4.63.6",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^6.0.3"
  }
}
